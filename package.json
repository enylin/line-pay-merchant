{
  "name": "line-pay-merchant",
  "version": "1.0.0-alpha.0",
  "description": "LINE Pay Online API V4 client for Node.js: zero dependencies, typed, with a way to look up payments whose outcome is unknown",
  "keywords": [
    "LINE Pay",
    "LINE",
    "Payment",
    "Merchant",
    "V4",
    "TypeScript",
    "ESM",
    "CommonJS"
  ],
  "homepage": "https://enylin.github.io/line-pay-merchant/",
  "bugs": {
    "url": "https://github.com/enylin/line-pay-merchant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enylin/line-pay-merchant.git"
  },
  "license": "MIT",
  "author": {
    "name": "Sean Lin",
    "email": "sean.enylin@gmail.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"for (const d of ['dist', 'coverage']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit && tsc -p examples/tsconfig.json && tsc -p docs/tsconfig.json",
    "lint": "eslint . && prettier --check . && npm run check:any",
    "check:any": "node scripts/check-no-any.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check:pack": "node scripts/pack-smoke.mjs",
    "docs:api": "typedoc && typedoc --out docs/en/api",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "npm run typecheck && npm run lint && npm run test:cov && npm run build && npm run check:package && npm run check:pack",
    "prepare": "husky",
    "prepublishOnly": "npm run verify",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
